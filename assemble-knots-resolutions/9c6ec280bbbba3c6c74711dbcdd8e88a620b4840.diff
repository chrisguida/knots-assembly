diff --git a/.travis.yml b/.travis.yml
index 502e640d..97d1fc6 100644
--- a/.travis.yml
+++ b/.travis.yml
@@ -14,6 +14,7 @@ cache:
   - $HOME/.ccache
 env:
   global:
+    - COMMON_PACKAGES="icnsutils librsvg2-bin imagemagick"
     - MAKEJOBS=-j3
     - RUN_TESTS=false
     - CHECK_DOC=0
@@ -48,8 +49,8 @@ before_install:
 install:
     - if [ -n "$PPA" ]; then travis_retry sudo add-apt-repository "$PPA" -y; fi
     - if [ -n "$DPKG_ADD_ARCH" ]; then sudo dpkg --add-architecture "$DPKG_ADD_ARCH" ; fi
-    - if [ -n "$PACKAGES" ]; then travis_retry sudo apt-get update; fi
-    - if [ -n "$PACKAGES" ]; then travis_retry sudo apt-get install --no-install-recommends --no-upgrade -qq $PACKAGES; fi
+    - if [ -n "$PACKAGES$COMMON_PACKAGES" ]; then travis_retry sudo apt-get update; fi
+    - if [ -n "$PACKAGES$COMMON_PACKAGES" ]; then travis_retry sudo apt-get install --no-install-recommends --no-upgrade -qq $COMMON_PACKAGES $PACKAGES; fi
 before_script:
     - unset CC; unset CXX
     - if [ "$CHECK_DOC" = 1 ]; then contrib/devtools/check-doc.py; fi
diff --git a/Makefile.am b/Makefile.am
index f3dc016..ca2496d 100644
--- a/Makefile.am
+++ b/Makefile.am
@@ -31,7 +31,7 @@ OSX_BACKGROUND_IMAGE_DPIS=36 72
