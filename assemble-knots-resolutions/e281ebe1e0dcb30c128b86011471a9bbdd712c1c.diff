index 2ff7be2..0b82c80 100644
--- a/src/Makefile.am
+++ b/src/Makefile.am
@@ -497,9 +497,16 @@ endif
 
 # Rendered icons must be here, not in Makefile.qt.include, since they are distributed with the source tarball
 
-RES_RENDERED_ICON_SOURCES = qt/res/src/bitcoin.svg
+RES_RENDERED_ICON_SOURCES = \
+  qt/res/src/hd_disabled.svg \
+  qt/res/src/hd_enabled.svg \
+  qt/res/src/network_disabled.svg \
+  qt/res/src/bitcoin.svg
 
 RES_RENDERED_ICONS = \
+  qt/res/rendered_icons/hd_disabled.png \
+  qt/res/rendered_icons/hd_enabled.png \
+  qt/res/rendered_icons/network_disabled.png \
   qt/res/rendered_icons/about.png \
   qt/res/rendered_icons/bitcoin.ico \
   qt/res/rendered_icons/bitcoin_testnet.ico \
@@ -515,6 +522,14 @@ EXTRA_DIST += $(RES_RENDERED_ICON_SOURCES) $(RES_ALL_RENDERED_ICONS)
 
 if CAN_RENDER_ICONS
 
+qt/res/rendered_icons/hd_%.png: qt/res/src/hd_%.svg
+	@$(MKDIR_P) $(@D)
+	$(RSVG_CONVERT) -f png < $< > $@
+
+qt/res/rendered_icons/network_disabled.png: qt/res/src/network_disabled.svg
+	@$(MKDIR_P) $(@D)
+	$(RSVG_CONVERT) -f png < $< > $@
+
 qt/res/rendered_icons/about.png: qt/res/rendered_icons/about.svg
 	$(RSVG_CONVERT) -f png -d 142 -p 142 < $< | $(IMAGEMAGICK_CONVERT) - -crop 128x128+7+7 -colorspace Gray -strip $@
 
